---
import '../styles/global.css';

const { title = 'Clif Code', description = 'Building things, learning out loud.', current = '' } = Astro.props;
const pageTitle = title === 'Clif Code' ? title : `${title} — Clif Code`;
const base = import.meta.env.BASE_URL;
const url = (path = '') => path ? `${base}${path.replace(/^\//, '').replace(/\/$/, '')}/` : base;
const nav = [
  ['Projects','projects'], ['Research','research'], ['Diary','diary'],
  ['AI','ai'], ['Systems','systems'], ['Markets','markets'],
  ['Philosophy','philosophy'], ['Notes','notes'], ['About','about']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
</head>
<body>
  <main class="site-shell">
    <header class="hero">
      <a class="identity-name" href={url()} aria-label="Clif Code home">
        <h1>Clif Code</h1>
      </a>

      <button class="theme-control" id="themeToggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
        <span aria-hidden="true">☼</span><span class="switch"><span class="knob"></span></span><span aria-hidden="true">☾</span>
      </button>

      <p class="hero-tagline" aria-label="Building things, learning out loud.">
        <span class="hero-tagline-ghost" aria-hidden="true">Building things, learning out loud.</span>
        <span class="hero-tagline-live" aria-hidden="true">
          <span class="hero-tagline-typed" id="heroTaglineTyped"></span><span class="hero-tagline-cursor" id="heroTaglineCursor" hidden></span>
        </span>
      </p>
    </header>

    <nav class="topic-nav" aria-label="Topics">
      {nav.map(([label, slug]) => <a href={url(slug)} aria-current={label === current ? 'page' : undefined}>{label}</a>)}
    </nav>
    <slot />
    <footer class="footer">cliffcode.eth</footer>
  </main>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const button = document.getElementById('themeToggle');
      const saved = localStorage.getItem('cliffcode-theme');
      const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
      const setTheme = (theme) => {
        theme === 'dark' ? root.setAttribute('data-theme', 'dark') : root.removeAttribute('data-theme');
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'dark' ? '#171717' : '#ffffff';
        button?.setAttribute('aria-pressed', String(theme === 'dark'));
      };
      setTheme(saved || (prefersDark ? 'dark' : 'light'));
      button?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        localStorage.setItem('cliffcode-theme', next);
        setTheme(next);
      });

      const tagline = document.getElementById('heroTaglineTyped');
      const cursor = document.getElementById('heroTaglineCursor');
      const text = 'Building things, learning out loud.';
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (tagline && cursor) {
        if (reduceMotion) {
          tagline.textContent = text;
          cursor.hidden = true;
        } else {
          cursor.hidden = false;

          let index = 0;
          const nextDelay = (char) => {
            if (char === ',') return 160;
            if (char === '.') return 120;
            if (char === ' ') return 52;
            return 38 + Math.floor(Math.random() * 18);
          };

          const typeNext = () => {
            if (index >= text.length) {
              cursor.classList.add('is-finishing');
              setTimeout(() => { cursor.hidden = true; }, 1100);
              return;
            }
            const char = text[index++];
            tagline.textContent += char;
            setTimeout(typeNext, nextDelay(char));
          };

          setTimeout(typeNext, 260);
        }
      }
    })();
  </script>
</body>
</html>
