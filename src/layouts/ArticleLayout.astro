---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path = '') => path ? `${base}${path.replace(/^\//, '').replace(/\/$/, '')}/` : base;
const date = new Date(frontmatter.date);
const dateLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
}).format(date);

const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1) || 'clif-code';
const socialImage = `${base}og/${slug}.png`;

// Titles wrap naturally and fill each line. Only a very short last word
// ("II", "me") is tied to the word before it so it never sits alone.
const titleWords = frontmatter.title.trim().split(' ');
const headingTitle =
  titleWords.length > 2 && titleWords.at(-1).length <= 3
    ? [...titleWords.slice(0, -2), `${titleWords.at(-2)}\u00A0${titleWords.at(-1)}`].join(' ')
    : frontmatter.title;

const titleLength = frontmatter.title.trim().length;
const titleSizeClass =
  titleLength > 46 ? 'article-title--very-long' :
  titleLength > 30 ? 'article-title--long' :
  'article-title--standard';
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  current={frontmatter.type === 'Diary' ? 'Diary' : ''}
  articleMode={true}
  socialImage={socialImage}
  socialType="article"
  publishedTime={date.toISOString()}
  section={frontmatter.type}
>
  <article class="article-page article-body">
    <header class="article-header">
      <h1 class={titleSizeClass}>{headingTitle}</h1>
      <div class="article-title-rule" aria-hidden="true"></div>
      <div class="article-meta-row">
        <div class="article-meta">
          <time datetime={frontmatter.date}>{dateLabel}</time>
          <span>·</span><a href={url(frontmatter.type.toLowerCase())}>{frontmatter.type}</a>
          {frontmatter.topics?.map((topic) => <><span>·</span><a href={url(topic.toLowerCase())}>{topic}</a></>)}
        </div>
        <a class="all-posts" href={url()}>All posts</a>
      </div>
    </header>
    <slot />
    <section class="article-related"><span>Related:</span> <a href={url('projects')}>Projects</a></section>
    <nav class="article-footer-nav"><a href={url()}>← Back to latest</a></nav>
  </article>
</BaseLayout>
