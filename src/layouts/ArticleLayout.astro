---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path = '') => path ? `${base}${path.replace(/^\//, '').replace(/\/$/, '')}/` : base;
const date = new Date(frontmatter.date);
const dateLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
}).format(date);

const titleLength = frontmatter.title.trim().length;
const titleSizeClass =
  titleLength > 46 ? 'article-title--very-long' :
  titleLength > 30 ? 'article-title--long' :
  'article-title--standard';
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} current={frontmatter.type === 'Diary' ? 'Diary' : ''} articleMode={true}>
  <article class="article-page article-body">
    <header class="article-header">
      <h1 class={titleSizeClass}>{frontmatter.title}</h1>
      <div class="article-title-rule" aria-hidden="true"></div>
      <div class="article-meta-row">
        <div class="article-meta">
          <time datetime={frontmatter.date}>{dateLabel}</time>
          <span>·</span><a href={url(frontmatter.type.toLowerCase())}>{frontmatter.type}</a>
          {frontmatter.topics?.map((topic) => <><span>·</span><a href={url(topic.toLowerCase())}>{topic}</a></>)}
        </div>
        <a class="all-posts" href={url()}>All posts</a>
      </div>
    </header>
    <slot />
    <section class="article-related"><span>Related:</span> <a href={url('projects')}>Projects</a></section>
    <nav class="article-footer-nav"><a href={url()}>← Back to latest</a></nav>
  </article>
</BaseLayout>
