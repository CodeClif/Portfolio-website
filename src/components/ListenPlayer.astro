---
const { minutes = 5 } = Astro.props;
---
<button class="inline-listen" id="inlineListen" type="button"><span>▶</span> Listen <span class="muted">· about {minutes} min</span></button>

<div class="sticky-player" id="stickyPlayer" hidden>
  <button class="player-btn transport" id="playerToggle" type="button" aria-label="Pause narration"><span class="pause-bars" aria-hidden="true"><i></i><i></i></span></button>
  <span class="player-time" id="playerTime">00:00</span>
  <button class="player-speed" id="playerSpeed" type="button" aria-label="Change playback speed">1×</button>
  <button class="player-btn jump" id="rewind15" type="button" aria-label="Go back 15 seconds">
    <svg class="jump-svg" viewBox="0 0 40 44" aria-hidden="true"><path class="jump-ring" d="M30.5 14.1a13.2 13.2 0 1 0 1.2 18.2"/><path class="jump-head" d="M30.4 7.2v8.1h-8.1"/><text x="20" y="31.5" text-anchor="middle">15</text></svg>
  </button>
  <button class="player-btn jump" id="forward15" type="button" aria-label="Go forward 15 seconds">
    <svg class="jump-svg" viewBox="0 0 40 44" aria-hidden="true"><path class="jump-ring" d="M9.5 14.1a13.2 13.2 0 1 1-1.2 18.2"/><path class="jump-head" d="M9.6 7.2v8.1h8.1"/><text x="20" y="31.5" text-anchor="middle">15</text></svg>
  </button>
  <button class="player-btn player-close" id="closePlayer" type="button" aria-label="Close narration">×</button>
</div>

<script>
const inline = document.getElementById('inlineListen');
const player = document.getElementById('stickyPlayer');
const transport = document.getElementById('playerToggle');
const timeEl = document.getElementById('playerTime');
const speedBtn = document.getElementById('playerSpeed');
const rewind = document.getElementById('rewind15');
const forward = document.getElementById('forward15');
const close = document.getElementById('closePlayer');

if (inline && player && transport && timeEl && speedBtn && rewind && forward && close && 'speechSynthesis' in window) {
  const narrationEls = [...document.querySelectorAll('.article-body h1, .article-body h2, .article-body p, .article-body blockquote > p')]
    .filter((el) => !el.closest('.source-note, .references'));
  let fullText = '', words = [], rate = 1, playing = false, paused = false, baseOffset = 0, currentWord = 0, utterance, lastFollow = 0, userScrollUntil = 0;

  narrationEls.forEach((el) => {
    const raw = el.textContent?.trim() || '';
    if (!raw) return;
    if (fullText) fullText += '\n\n';
    const elementStart = fullText.length;
    fullText += raw;
    const parts = raw.match(/\S+|\s+/g) || [];
    el.textContent = '';
    let local = 0;
    for (const part of parts) {
      if (/^\s+$/.test(part)) { el.appendChild(document.createTextNode(part)); local += part.length; continue; }
      const span = document.createElement('span');
      span.className = 'narration-word';
      span.textContent = part;
      el.appendChild(span);
      words.push({ start: elementStart + local, span });
      local += part.length;
    }
  });

  const fmt = (seconds) => {
    const s = Math.max(0, Math.floor(seconds));
    return `${String(Math.floor(s / 60)).padStart(2,'0')}:${String(s % 60).padStart(2,'0')}`;
  };
  const secondsAt = (i) => i / (2.55 * rate);
  const wordForChar = (charIndex) => {
    let lo = 0, hi = words.length - 1, answer = 0;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (words[mid].start <= charIndex) { answer = mid; lo = mid + 1; } else hi = mid - 1;
    }
    return answer;
  };
  const setTransport = (isPlaying) => {
    transport.innerHTML = isPlaying
      ? '<span class="pause-bars" aria-hidden="true"><i></i><i></i></span>'
      : '<span class="play-triangle" aria-hidden="true">▶</span>';
  };
  const follow = () => {
    if (Date.now() < userScrollUntil || Date.now() - lastFollow < 700) return;
    const el = words[currentWord]?.span;
    if (!el) return;
    const rect = el.getBoundingClientRect(), topGuard = 105, bottomGuard = innerHeight * .76;
    if (rect.bottom > bottomGuard) { lastFollow = Date.now(); window.scrollBy({top: rect.bottom - bottomGuard + 82, behavior:'smooth'}); }
    else if (rect.top < topGuard) { lastFollow = Date.now(); window.scrollBy({top: rect.top - topGuard - 20, behavior:'smooth'}); }
  };
  const paint = (index) => {
    currentWord = Math.max(0, Math.min(words.length - 1, index));
    words.forEach((word, i) => {
      word.span.classList.toggle('word-read', i < currentWord);
      word.span.classList.toggle('word-current', i === currentWord);
    });
    timeEl.textContent = fmt(secondsAt(currentWord));
    follow();
  };
  const speakFrom = (index) => {
    speechSynthesis.cancel();
    const i = Math.max(0, Math.min(words.length - 1, index));
    paint(i);
    baseOffset = words[i].start;
    utterance = new SpeechSynthesisUtterance(fullText.slice(baseOffset));
    utterance.lang = 'en';
    utterance.rate = rate;
    utterance.onboundary = (event) => {
      if (event.name && event.name !== 'word') return;
      paint(wordForChar(baseOffset + (event.charIndex || 0)));
    };
    utterance.onend = () => { playing = false; paused = false; setTransport(false); paint(words.length - 1); };
    utterance.onerror = () => { playing = false; paused = false; setTransport(false); };
    playing = true; paused = false; setTransport(true); speechSynthesis.speak(utterance);
  };
  const openPlayer = () => { player.hidden = false; document.body.classList.add('player-open'); };
  const closePlayer = () => {
    speechSynthesis.cancel(); playing = false; paused = false; player.hidden = true;
    document.body.classList.remove('player-open'); setTransport(true);
    words.forEach((word) => word.span.classList.remove('word-read','word-current'));
    currentWord = 0; timeEl.textContent = '00:00';
  };

  ['touchstart','pointerdown','wheel'].forEach((evt) => window.addEventListener(evt, (event) => {
    if (!player.contains(event.target)) userScrollUntil = Date.now() + 5000;
  }, {passive:true}));

  inline.addEventListener('click', () => { openPlayer(); speakFrom(currentWord || 0); });
  transport.addEventListener('click', () => {
    if (!playing) { openPlayer(); speakFrom(currentWord || 0); return; }
    if (paused) { speechSynthesis.resume(); paused = false; setTransport(true); }
    else { speechSynthesis.pause(); paused = true; setTransport(false); }
  });
  rewind.addEventListener('click', () => speakFrom(Math.max(0, currentWord - Math.round(15 * 2.55 * rate))));
  forward.addEventListener('click', () => speakFrom(Math.min(words.length - 1, currentWord + Math.round(15 * 2.55 * rate))));
  speedBtn.addEventListener('click', () => {
    const rates = [1,1.15,1.3,.9];
    rate = rates[(rates.indexOf(rate) + 1) % rates.length];
    speedBtn.textContent = `${rate === 1 ? '1' : rate}×`;
    if (playing && !paused) speakFrom(currentWord);
  });
  close.addEventListener('click', closePlayer);
  window.addEventListener('pagehide', () => speechSynthesis.cancel());
} else if (inline) {
  inline.hidden = true;
}
</script>
