---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BADGES } from '../scripts/grass-game.js';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Touch grass"
  description="A hill of grass you can run your hand through, in the morning, at golden hour or at night. Find the four-leaf clover."
  immersive={true}
  socialImage={`${base}share/touch-grass.png`}
>
  <div class="grass-page" id="grassPage">
    <canvas id="grassCanvas" aria-label="A grassy hill with a tree on top. Move or drag across it to run your hand through the grass."></canvas>

    <a class="grass-home glass" href={base}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5"/></svg>
      Clif Code
    </a>

    <div class="grass-modes glass" role="radiogroup" aria-label="Time of day">
      <button type="button" role="radio" data-mode="morning" aria-checked="false">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"/></svg>
        Morning
      </button>
      <button type="button" role="radio" data-mode="golden" aria-checked="false">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 11a4.5 4.5 0 0 1 9 0M1.5 13.5h13M8 3.5v1.6M3 6l1.1 1.1M13 6l-1.1 1.1"/></svg>
        Golden
      </button>
      <button type="button" role="radio" data-mode="night" aria-checked="false">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 9.6A5.5 5.5 0 0 1 6.4 3a5.5 5.5 0 1 0 6.6 6.6z"/></svg>
        Night
      </button>
    </div>

    <div class="grass-tools glass" role="toolbar" aria-label="Tools" aria-orientation="vertical">
      <button type="button" data-tool="hand" aria-pressed="true" aria-label="Hand: brush the grass">
        <span aria-hidden="true">✋</span>
      </button>
      <button type="button" data-tool="cut" aria-pressed="false" aria-label="Cutlass: cut the grass" class="is-locked" id="cutlassButton">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="blade" d="M9.5 14.5 19.6 3.2c1-.9 2.3-.4 1.9.9-1 3.3-4.6 8.2-9.3 12.2z"/><path class="handle" d="M2.6 19.2l5.4-5.6 2.5 2.5-5.6 5.4a1.6 1.6 0 0 1-2.3-2.3z"/></svg>
        <small class="grass-lock" aria-hidden="true">🔒</small>
      </button>
      <button type="button" id="rainButton" aria-label="Make it rain">
        <span aria-hidden="true">🌧️</span>
        <small class="grass-wait" id="rainWait"></small>
      </button>
    </div>

    <div class="grass-stats">
      <button class="grass-sound glass" id="soundButton" type="button" aria-pressed="true" aria-label="Sound">
        <svg class="grass-sound-on" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 7.5h3l4-3.5v12l-4-3.5h-3z"/><path d="M13.5 7a4 4 0 0 1 0 6M15.8 4.8a7 7 0 0 1 0 10.4"/></svg>
        <svg class="grass-sound-off" viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 7.5h3l4-3.5v12l-4-3.5h-3z"/><path d="M13.5 7.5l4 5M17.5 7.5l-4 5"/></svg>
      </button>
      <button class="grass-stats-button glass" id="statsButton" type="button" aria-expanded="false" aria-controls="statsPanel">
        <span aria-hidden="true">🌱</span>
        <span>Lv <b id="statsLevel">1</b></span>
        <span class="grass-stats-visitors" id="statsVisitorsShort"></span>
        <svg class="grass-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg>
      </button>

      <div class="grass-panel glass" id="statsPanel" role="dialog" aria-label="Your grass" hidden>
        <span class="grass-grabber" aria-hidden="true"></span>
        <header class="grass-panel-head">
          <div class="grass-ring" id="levelRing" aria-hidden="true"><b id="ringLevel">1</b></div>
          <div class="grass-head-text">
            <p class="grass-eyebrow">Level <span id="panelLevel">1</span></p>
            <p class="grass-title" id="panelTitle">Indoor kid</p>
            <p class="grass-sub" id="panelPoints">0 grass points</p>
          </div>
          <button class="grass-close glass" id="panelClose" type="button" aria-label="Close">
            <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7"/></svg>
          </button>
        </header>

        <div class="grass-panel-body">
          <section>
            <h2>Everyone</h2>
            <div class="grass-tile grass-hero">
              <b id="sharedVisitors">—</b>
              <span>people have touched grass here</span>
            </div>
            <div class="grass-pair">
              <div class="grass-tile"><b id="sharedCutToday">—</b><span>blades cut today</span></div>
              <div class="grass-tile"><b id="sharedMinutes">—</b><span>minutes together</span></div>
              <div class="grass-tile"><b id="sharedClovers">—</b><span>clovers found</span></div>
            </div>
          </section>

          <section>
            <h2>You</h2>
            <ul class="grass-you">
              <li class="grass-tile"><b id="youTime">0:00</b><span>touching grass</span></li>
              <li class="grass-tile"><b id="youStreak">0</b><span>day streak</span></li>
              <li class="grass-tile"><b id="youClovers">0</b><span>clovers</span></li>
              <li class="grass-tile"><b id="youCut">0</b><span>blades cut</span></li>
              <li class="grass-tile"><b id="youFlowers">0</b><span>flowers</span></li>
              <li class="grass-tile"><b id="youButterflies">0</b><span>butterflies</span></li>
            </ul>
          </section>

          <section>
            <h2>Badges <span id="badgeCount"></span></h2>
            <ul class="grass-badges">
              {BADGES.map((badge) => (
                <li data-badge={badge.id} title={badge.hint}>
                  <span class="grass-badge-icon" aria-hidden="true">{badge.icon}</span>
                  <span class="grass-badge-name">{badge.name}</span>
                  <span class="grass-badge-hint">{badge.hint}</span>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>How to play</h2>
            <p class="grass-tile grass-how">Turn your sound on, then run your hand through the grass to earn grass points. Touch grass for 30 seconds to earn a cutlass and clear the field; it grows back slowly, or fast if you make it rain. A four-leaf clover is hiding low in the grass near you: sweep around until it glints, then tap it. Tap flowers, butterflies, the tree, and the goat if it wanders by.</p>
          </section>
        </div>
      </div>
    </div>

    <div class="grass-toasts" id="toasts" aria-live="polite"></div>
    <p class="grass-hint glass" id="grassHint">Run your hand through the grass</p>
    <p class="grass-fallback" id="grassFallback" hidden>This needs WebGL, which your browser has turned off. Go outside instead.</p>
  </div>
</BaseLayout>

<style>
  /* The page itself sits behind the 3D scene; keep it sky-coloured rather than white,
     so a moment where the browser shows no frame is not a white flash. */
  :global(html:has(.grass-page)), :global(body:has(.grass-page)) { margin: 0; overflow: hidden; background: #c9dbe3; }
  .grass-page {
    position: fixed; inset: 0; overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    /* glass that adapts to the scene: light by day, smoky at night */
    --tint: 255, 255, 255; --tint-a: .34; --tint-b: .14;
    --ink: #101114; --ink-soft: rgba(16, 17, 20, .58);
    --tile: rgba(255, 255, 255, .34); --tile-edge: rgba(255, 255, 255, .55);
    --thumb: rgba(255, 255, 255, .85); --accent: #34c759;
    --numbers: ui-rounded, "SF Pro Rounded", -apple-system, sans-serif;
    transition: --ink .4s;
  }
  .grass-page[data-scene="night"] {
    --tint: 28, 32, 66; --tint-a: .42; --tint-b: .22;
    --ink: #f4f5ff; --ink-soft: rgba(244, 245, 255, .62);
    --tile: rgba(255, 255, 255, .09); --tile-edge: rgba(255, 255, 255, .16);
    --thumb: rgba(255, 255, 255, .2);
  }
  #grassCanvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  #grassCanvas:active { cursor: grabbing; }

  /* Liquid glass: a frosted, colour-boosted blur, a bright specular rim that
     catches light on the top-left and bottom-right, and a soft lift. */
  .glass {
    isolation: isolate;
    color: var(--ink);
    background: linear-gradient(160deg, rgba(var(--tint), var(--tint-a)), rgba(var(--tint), var(--tint-b)));
    backdrop-filter: blur(22px) saturate(185%) brightness(1.04);
    -webkit-backdrop-filter: blur(22px) saturate(185%) brightness(1.04);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, .55),
      inset 0 -1px 1px rgba(255, 255, 255, .1),
      0 8px 28px rgba(0, 0, 0, .14),
      0 1px 3px rgba(0, 0, 0, .06);
  }
  .glass::before {
    content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, .85), rgba(255, 255, 255, .08) 38%, rgba(255, 255, 255, .02) 62%, rgba(255, 255, 255, .5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
  }

  .grass-home {
    position: absolute; top: max(16px, env(safe-area-inset-top)); left: 16px;
    display: flex; align-items: center; gap: 4px; padding: 8px 14px 8px 10px; border-radius: 999px;
    font-size: .86rem; font-weight: 600; text-decoration: none;
  }
  .grass-home svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .grass-home:hover { text-decoration: none; }

  .grass-modes {
    position: absolute; top: max(16px, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%);
    display: flex; gap: 2px; padding: 4px; border-radius: 999px;
  }
  .grass-modes button {
    display: flex; align-items: center; gap: 6px; padding: 8px 14px; border: 0; border-radius: 999px;
    font-family: inherit; font-size: .84rem; font-weight: 600; line-height: 1;
    color: var(--ink-soft); background: transparent; cursor: pointer;
    transition: background .3s, color .3s, box-shadow .3s;
  }
  .grass-modes button[aria-checked="true"] {
    color: var(--ink); background: var(--thumb);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, .7), 0 2px 10px rgba(0, 0, 0, .1);
  }
  .grass-modes svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
  .grass-modes button[data-mode="night"] svg { fill: currentColor; stroke: none; }

  /* the tools: hand, cutlass, rain */
  .grass-tools {
    position: absolute; right: 16px; top: 50%; transform: translateY(-50%); z-index: 2;
    display: grid; gap: 4px; padding: 5px; border-radius: 999px;
  }
  .grass-tools button {
    position: relative; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer; background: transparent; color: var(--ink);
    font-size: 1.3rem; line-height: 1; transition: background .25s, box-shadow .25s, transform .15s;
  }
  .grass-tools button:active { transform: scale(.92); }
  .grass-tools button[aria-pressed="true"] { background: var(--thumb); box-shadow: inset 0 1px 1px rgba(255, 255, 255, .7), 0 2px 10px rgba(0, 0, 0, .12); }
  .grass-tools svg { width: 24px; height: 24px; }
  .grass-tools .blade { fill: #d9dde2; stroke: #7d848c; stroke-width: .8; }
  .grass-tools .handle { fill: #6b4423; }
  .grass-lock, .grass-wait {
    position: absolute; right: -2px; bottom: -2px; min-width: 18px; padding: 1px 4px; border-radius: 999px;
    font-size: .62rem; font-weight: 700; line-height: 1.4; color: var(--ink); background: var(--thumb);
    box-shadow: 0 1px 4px rgba(0, 0, 0, .15);
  }
  .grass-wait:empty, .grass-tools button:not(.is-locked) .grass-lock { display: none; }
  .grass-tools .is-locked svg { filter: grayscale(1); opacity: .45; }
  .grass-tools .is-cooling > span { opacity: .4; }
  .grass-tools .is-new { animation: tool-new 1.2s ease-in-out 3; }
  @keyframes tool-new { 50% { transform: scale(1.18); box-shadow: 0 0 0 6px rgba(255, 214, 102, .55); } }
  #grassCanvas.is-cutting { cursor: crosshair; }

  /* the stats capsule and its glass drop-down */
  .grass-stats { position: absolute; top: max(16px, env(safe-area-inset-top)); right: 16px; z-index: 3; display: flex; gap: 8px; }
  .grass-sound {
    position: relative; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
  }
  .grass-sound svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .grass-sound svg path:first-child { fill: currentColor; }
  .grass-sound[aria-pressed="true"] .grass-sound-off, .grass-sound[aria-pressed="false"] .grass-sound-on { display: none; }
  .grass-stats-button {
    position: relative; display: flex; align-items: center; gap: 7px; padding: 8px 12px 8px 13px; border: 0; border-radius: 999px;
    font-family: inherit; font-size: .86rem; font-weight: 600; line-height: 1; cursor: pointer;
  }
  .grass-stats-button b { font-family: var(--numbers); }
  .grass-stats-visitors { font-weight: 500; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .grass-stats-visitors:empty { display: none; }
  .grass-chevron { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; transition: transform .25s; }
  .grass-stats-button[aria-expanded="true"] .grass-chevron { transform: rotate(180deg); }

  .grass-panel {
    position: absolute; top: calc(100% + 10px); right: 0; width: 360px;
    max-height: calc(100vh - 96px); max-height: calc(100dvh - 96px);
    display: flex; flex-direction: column; overflow: hidden;
    border-radius: 30px;
    --tint-a: .66; --tint-b: .5;
    backdrop-filter: blur(30px) saturate(190%) brightness(1.05);
    -webkit-backdrop-filter: blur(30px) saturate(190%) brightness(1.05);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, .6), 0 24px 60px rgba(0, 0, 0, .22), 0 2px 8px rgba(0, 0, 0, .06);
    transform-origin: top right; animation: panel-in .32s cubic-bezier(.2, .9, .25, 1.15);
  }
  .grass-page[data-scene="night"] .grass-panel { --tint-a: .62; --tint-b: .5; }
  .grass-panel[hidden] { display: none; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(-10px) scale(.94); } }
  .grass-grabber { display: none; }

  .grass-panel-head { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 18px 16px 14px 18px; }
  .grass-ring {
    --p: 0; position: relative; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center;
    background: conic-gradient(var(--accent) calc(var(--p) * 1%), rgba(var(--tint), .3) 0);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .35);
  }
  .grass-ring::after { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: rgba(var(--tint), .55); box-shadow: inset 0 1px 1px rgba(255, 255, 255, .6); }
  .grass-ring b { position: relative; z-index: 1; font-family: var(--numbers); font-size: 1.3rem; font-weight: 700; }
  .grass-eyebrow { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
  .grass-title { margin: 2px 0 0; font-size: 1.2rem; font-weight: 700; letter-spacing: -.01em; }
  .grass-sub { margin: 3px 0 0; font-size: .78rem; color: var(--ink-soft); }
  .grass-close {
    position: relative; align-self: start; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
  }
  .grass-close svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }

  .grass-panel-body { overflow-y: auto; overscroll-behavior: contain; padding: 0 16px 18px; -webkit-overflow-scrolling: touch; }
  .grass-panel section + section { margin-top: 18px; }
  .grass-panel h2 { margin: 0 0 8px 4px; font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
  .grass-panel h2 span { margin-left: 4px; font-weight: 600; letter-spacing: 0; text-transform: none; }
  .grass-tile {
    margin: 0; padding: 12px; border-radius: 18px; background: var(--tile);
    box-shadow: inset 0 1px 0 var(--tile-edge), inset 0 0 0 .5px rgba(255, 255, 255, .18);
  }
  .grass-tile b { display: block; font-family: var(--numbers); font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
  .grass-tile span { display: block; margin-top: 2px; font-size: .74rem; line-height: 1.3; color: var(--ink-soft); }
  .grass-hero { display: flex; align-items: baseline; gap: 10px; padding: 14px 16px; }
  .grass-hero b { font-size: 2.1rem; line-height: 1; }
  .grass-hero span { margin: 0; font-size: .86rem; }
  .grass-pair { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }
  .grass-pair .grass-tile { padding: 11px 8px; text-align: center; }
  .grass-pair .grass-tile b { font-size: 1.1rem; }
  .grass-you { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; padding: 0; list-style: none; }
  .grass-you .grass-tile { text-align: center; padding: 11px 6px; }

  .grass-badges { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 8px; margin: 0; padding: 4px 0 0; list-style: none; }
  .grass-badges li { display: grid; justify-items: center; text-align: center; gap: 2px; }
  .grass-badge-icon {
    width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 4px;
    font-size: 1.55rem; background: var(--tile);
    box-shadow: inset 0 1px 1px var(--tile-edge), inset 0 0 0 .5px rgba(255, 255, 255, .2);
  }
  .grass-badges li.is-earned .grass-badge-icon {
    background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, .85), rgba(255, 236, 170, .55) 45%, rgba(255, 200, 90, .35));
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, .9), 0 0 0 2px rgba(255, 214, 102, .55), 0 4px 14px rgba(255, 190, 60, .35);
  }
  .grass-badge-name { font-size: .72rem; font-weight: 650; line-height: 1.2; }
  .grass-badge-hint { font-size: .64rem; line-height: 1.25; color: var(--ink-soft); }
  .grass-badges li:not(.is-earned) .grass-badge-icon { filter: grayscale(1); opacity: .45; }
  .grass-badges li:not(.is-earned) .grass-badge-name { color: var(--ink-soft); }
  .grass-how { font-size: .84rem; line-height: 1.5; padding: 14px 16px; }

  /* toasts are added by script, so their styles are global */
  .grass-toasts {
    position: absolute; top: max(68px, calc(env(safe-area-inset-top) + 56px)); left: 50%; transform: translateX(-50%);
    display: grid; gap: 8px; justify-items: center; pointer-events: none; z-index: 2;
  }
  :global(.grass-toast) {
    position: relative; isolation: isolate; padding: 10px 16px; border-radius: 999px; white-space: nowrap;
    font-size: .88rem; font-weight: 600; color: var(--ink);
    background: linear-gradient(160deg, rgba(var(--tint), calc(var(--tint-a) + .2)), rgba(var(--tint), calc(var(--tint-b) + .15)));
    backdrop-filter: blur(22px) saturate(185%); -webkit-backdrop-filter: blur(22px) saturate(185%);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, .6), 0 10px 30px rgba(0, 0, 0, .16);
    animation: toast-in .45s cubic-bezier(.2, .9, .25, 1.25);
  }
  :global(.grass-toast.is-leaving) { opacity: 0; transform: translateY(-8px) scale(.96); transition: opacity .3s, transform .3s; }
  @keyframes toast-in { from { opacity: 0; transform: translateY(-12px) scale(.9); } }

  .grass-hint {
    position: absolute; left: 50%; bottom: max(26px, env(safe-area-inset-bottom)); transform: translateX(-50%);
    margin: 0; padding: 9px 16px; border-radius: 999px; white-space: nowrap;
    font-size: .84rem; font-weight: 600; line-height: 1;
    font-variant-numeric: tabular-nums; pointer-events: none;
  }
  .grass-fallback { position: absolute; inset: auto 16px 40%; margin: 0; text-align: center; font-size: 1rem; line-height: 1.5; color: #234; }

  @media (max-width: 600px) {
    .grass-home { top: auto; bottom: max(18px, env(safe-area-inset-bottom)); left: 16px; }
    .grass-modes { top: max(12px, env(safe-area-inset-top)); }
    .grass-modes button { padding: 8px 11px; font-size: .8rem; gap: 5px; }
    .grass-hint { bottom: max(70px, calc(env(safe-area-inset-bottom) + 52px)); }
    /* on phones the stats sit bottom-right and open upward as a sheet */
    .grass-stats { top: auto; bottom: max(18px, env(safe-area-inset-bottom)); right: 16px; }
    .grass-panel {
      position: fixed; top: auto; left: 8px; right: 8px; bottom: max(70px, calc(env(safe-area-inset-bottom) + 54px));
      width: auto; max-height: 74vh; max-height: 74dvh; border-radius: 32px; transform-origin: bottom center;
      animation-name: sheet-in;
    }
    @keyframes sheet-in { from { opacity: 0; transform: translateY(24px) scale(.97); } }
    .grass-grabber { display: block; width: 38px; height: 5px; margin: 8px auto -6px; border-radius: 99px; background: var(--ink-soft); opacity: .45; }
    .grass-panel-head { padding-top: 14px; }
    .grass-toasts { top: max(62px, calc(env(safe-area-inset-top) + 52px)); }
    :global(.grass-toast) { font-size: .82rem; }
  }
</style>

<script>
  import { startTouchGrass } from '../scripts/touch-grass.js';
  import { createFeedback } from '../scripts/grass-sound.js';
  import {
    SHARED, POINTS, BADGES, CUT_BUNDLE, CUTLASS_AFTER_MS, cutTodayKey, bumpShared, readShared, levelFor,
    loadStats, saveStats, recordVisit, newBadges, formatTime, formatCount
  } from '../scripts/grass-game.js';

  const $ = (id) => document.getElementById(id);
  const canvas = $('grassCanvas');
  const hint = $('grassHint');
  const modeButtons = [...document.querySelectorAll('.grass-modes button')];

  // ---- your stats, kept in this browser
  const stats = loadStats();

  // ---- sound and haptics; audio may only start once the visitor touches the page
  const feedback = createFeedback();
  const soundButton = $('soundButton');
  const showSound = () => {
    soundButton.setAttribute('aria-pressed', String(feedback.enabled));
    soundButton.setAttribute('aria-label', feedback.enabled ? 'Sound on' : 'Sound off');
  };
  showSound();
  soundButton.addEventListener('click', () => { feedback.setEnabled(!feedback.enabled); showSound(); });
  for (const type of ['pointerdown', 'touchend', 'keydown']) addEventListener(type, () => feedback.unlock(), { passive: true });
  recordVisit(stats);
  let mode = 'morning';

  // ---- toasts for finds, badges and level-ups
  const toasts = $('toasts');
  const toast = (text) => {
    const el = document.createElement('div');
    el.className = 'grass-toast';
    el.textContent = text;
    toasts.append(el);
    while (toasts.children.length > 3) toasts.firstChild.remove();
    setTimeout(() => { el.classList.add('is-leaving'); setTimeout(() => el.remove(), 320); }, 2800);
  };

  // ---- the stats drop-down
  const shared = { visitors: null, minutes: null, clovers: null, cutToday: null };
  let sharedReadAt = 0;
  const statsButton = $('statsButton');
  const panel = $('statsPanel');
  const render = () => {
    const level = levelFor(stats.points);
    $('statsLevel').textContent = level.number;
    $('statsVisitorsShort').textContent = shared.visitors ? `· ${formatCount(shared.visitors)} 👥` : '';
    if (panel.hidden) return;
    $('panelLevel').textContent = level.number;
    $('ringLevel').textContent = level.number;
    $('panelTitle').textContent = level.title;
    $('levelRing').style.setProperty('--p', Math.round(level.progress * 100));
    $('panelPoints').textContent = level.next
      ? `${formatCount(Math.floor(stats.points))} grass points · ${formatCount(level.next - Math.floor(stats.points))} to the next level`
      : `${formatCount(Math.floor(stats.points))} grass points · top level`;
    $('sharedVisitors').textContent = formatCount(shared.visitors);
    $('sharedMinutes').textContent = formatCount(shared.minutes);
    $('sharedClovers').textContent = formatCount(shared.clovers);
    $('sharedCutToday').textContent = shared.cutToday == null ? '—' : formatCount(shared.cutToday * CUT_BUNDLE);
    $('youCut').textContent = formatCount(stats.cut);
    $('youTime').textContent = formatTime(stats.touchedMs);
    $('youStreak').textContent = stats.streak;
    $('youClovers').textContent = stats.clovers;
    $('youFlowers').textContent = stats.flowers;
    $('youButterflies').textContent = stats.butterflies;
    let earned = 0;
    document.querySelectorAll('[data-badge]').forEach((el) => {
      const has = Boolean(stats.badges[el.dataset.badge]);
      el.classList.toggle('is-earned', has);
      earned += has;
    });
    $('badgeCount').textContent = `${earned} of ${BADGES.length}`;
  };
  const refreshShared = async () => {
    if (Date.now() - sharedReadAt < 20000) return;
    sharedReadAt = Date.now();
    const [visitors, minutes, clovers, cutToday] = await Promise.all([
      readShared(SHARED.visitors), readShared(SHARED.minutes), readShared(SHARED.clovers), readShared(cutTodayKey())
    ]);
    if (cutToday != null) shared.cutToday = cutToday;
    if (visitors != null) shared.visitors = visitors;
    if (minutes != null) shared.minutes = minutes;
    if (clovers != null) shared.clovers = clovers;
    render();
  };
  const setOpen = (open) => {
    panel.hidden = !open;
    statsButton.setAttribute('aria-expanded', String(open));
    hint.style.visibility = open ? 'hidden' : '';
    if (open) { render(); refreshShared(); }
  };
  statsButton.addEventListener('click', () => setOpen(panel.hidden));
  $('panelClose').addEventListener('click', () => { setOpen(false); statsButton.focus(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  canvas.addEventListener('pointerdown', () => setOpen(false));

  // Count each browser once as a visitor.
  (async () => {
    const value = stats.counted ? await readShared(SHARED.visitors) : await bumpShared(SHARED.visitors);
    if (value != null) {
      shared.visitors = value;
      if (!stats.counted) { stats.counted = true; saveStats(stats); }
    }
    render();
  })();

  // ---- scoring
  let level = levelFor(stats.points).number;
  const changed = () => {
    for (const badge of newBadges(stats)) { toast(`${badge.icon} Badge: ${badge.name}`); feedback.event('badge'); }
    const now = levelFor(stats.points);
    if (now.number > level) { toast(`🎉 Level ${now.number}: ${now.title}`); feedback.event('level'); }
    level = now.number;
    render();
  };
  let lastShake = 0, lastCutSound = 0, cutCarry = 0, cutBundlesToSend = 0, goatSeen = false;
  // cutting happens many times a second, so save and refresh the panel a moment later
  let laterTimer = 0;
  const later = () => { if (!laterTimer) laterTimer = setTimeout(() => { laterTimer = 0; changed(); saveStats(stats); }, 400); };
  // send today's cut count up one bundle at a time, gently, so the counter is never rushed
  setInterval(() => {
    if (!cutBundlesToSend) return;
    cutBundlesToSend -= 1;
    bumpShared(cutTodayKey()).then((v) => { if (v != null) { shared.cutToday = v; render(); } });
  }, 1200);
  const onEvent = (kind, detail) => {
    if (kind !== 'cut') feedback.event(kind);
    if (kind === 'clover') {
      stats.clovers += 1; stats.points += POINTS.clover;
      toast('🍀 You found a four-leaf clover! +50');
      bumpShared(SHARED.clovers).then((v) => { if (v != null) { shared.clovers = v; render(); } });
    } else if (kind === 'flower') {
      stats.flowers += 1; stats.points += POINTS.flower;
      if (stats.flowers % 5 === 0) toast(`💐 ${stats.flowers} flowers picked`);
    } else if (kind === 'butterfly') {
      stats.butterflies += 1; stats.points += POINTS.butterfly;
      toast('🦋 A butterfly says hello. +10');
    } else if (kind === 'cut') {
      stats.cut += detail;
      stats.points += detail / POINTS.bladesPerPoint;
      cutCarry += detail;
      while (cutCarry >= CUT_BUNDLE) { cutCarry -= CUT_BUNDLE; cutBundlesToSend += 1; }
      // one swish at a time, however many blades a stroke takes
      const now = performance.now();
      if (now - lastCutSound > 110) { lastCutSound = now; feedback.event('cut'); }
      return later();
    } else if (kind === 'rain') {
      if (detail) { stats.rains += 1; stats.points += POINTS.rain; toast('🌧️ Rain! The grass is growing back'); }
      else toast('🌧️ A shower rolls in');
    } else if (kind === 'goat') {
      stats.goats += 1; stats.points += POINTS.goat;
      toast('🐐 Meeeh! The goat says hi');
    } else if (kind === 'goat-arrives') {
      if (!goatSeen) { goatSeen = true; toast('🐐 A goat wandered in. Tap it to say hi'); }
    } else if (kind === 'shake') {
      stats.shakes += 1;
      if (performance.now() - lastShake > 3000) stats.points += POINTS.shake;
      lastShake = performance.now();
    }
    changed();
    saveStats(stats);
  };

  // ---- the touched-grass timer
  let sessionMs = 0, lastTouch = -1, lastTick = performance.now(), sharedMinutesSent = 0, nudged = false;
  const caption = () => {
    const sec = sessionMs / 1000;
    const note = sec >= 300 ? ' · certified grass toucher'
      : sec >= 60 && sec < 90 ? ' · look at you, outside'
      : sec >= 12 && sec < 30 && !stats.clovers ? ' · find the four-leaf clover' : '';
    return `Touched grass for ${formatTime(sessionMs)}${note}`;
  };
  const tick = (now) => {
    const step = Math.min(now - lastTick, 100);
    lastTick = now;
    if (now - lastTouch < 450) {
      sessionMs += step;
      stats.touchedMs += step;
      stats.points += (step / 1000) * POINTS.second;
      stats.modes[mode] = true;
      // add to everyone's minutes, one whole minute at a time
      const minutes = Math.floor(sessionMs / 60000);
      if (minutes > sharedMinutesSent) {
        sharedMinutesSent = minutes;
        bumpShared(SHARED.minutes).then((v) => { if (v != null) shared.minutes = v; });
      }
      if (!hasCutlass && stats.touchedMs >= CUTLASS_AFTER_MS) unlockCutlass(true);
      if (!nudged && sessionMs > 20000 && !stats.clovers) {
        nudged = true;
        toast('🍀 Psst… a four-leaf clover is hiding in this grass');
      }
    }
    // only touch the page when the words change, so the 3D scene is not repainted for nothing
    if (lastTouch > 0) { const text = caption(); if (hint.textContent !== text) hint.textContent = text; }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
  setInterval(() => { changed(); saveStats(stats); }, 2000);
  addEventListener('pagehide', () => saveStats(stats));

  // ---- tools: the hand, the cutlass (earned), and rain (with a cooldown)
  const toolButtons = [...document.querySelectorAll('[data-tool]')];
  const cutlassButton = $('cutlassButton');
  let hasCutlass = false;
  const unlockCutlass = (justNow) => {
    hasCutlass = true;
    cutlassButton.classList.remove('is-locked');
    if (justNow) {
      cutlassButton.classList.add('is-new');
      toast('🗡️ You earned a cutlass! Pick it from the tools');
      feedback.event('unlock');
    }
  };
  if (stats.touchedMs >= CUTLASS_AFTER_MS) unlockCutlass(false);
  const pickTool = (name) => {
    toolButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tool === name)));
    canvas.classList.toggle('is-cutting', name === 'cut');
    grass?.setTool(name);
  };
  toolButtons.forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.tool === 'cut' && !hasCutlass) {
      const left = Math.ceil((CUTLASS_AFTER_MS - stats.touchedMs) / 1000);
      toast(`🔒 Touch grass for ${left} more second${left === 1 ? '' : 's'} to earn the cutlass`);
      return;
    }
    cutlassButton.classList.remove('is-new');
    pickTool(b.dataset.tool);
  }));
  const rainButton = $('rainButton');
  let rainReadyAt = 0;
  rainButton.addEventListener('click', () => {
    const wait = grass?.rain() ?? 0;
    if (wait > 0) { toast(`☁️ The clouds are refilling: ${wait}s`); return; }
    rainReadyAt = performance.now() + 25000;
  });
  setInterval(() => {
    const left = Math.ceil((rainReadyAt - performance.now()) / 1000);
    $('rainWait').textContent = left > 0 ? left : '';
    rainButton.classList.toggle('is-cooling', left > 0);
  }, 250);

  const grass = startTouchGrass({
    canvas,
    onTouch: (speed) => { lastTouch = performance.now(); feedback.rustle(speed); },
    onEvent
  });
  window.touchGrass = grass;

  // ---- time of day; opens at the visitor's own time
  const select = (name, instant = false) => {
    mode = name;
    feedback.setScene(name);
    $('grassPage').dataset.scene = name;
    modeButtons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.mode === name)));
    grass?.setMode(name, instant);
  };
  const hour = new Date().getHours();
  const initial = hour >= 5 && hour < 15 ? 'morning' : hour >= 15 && hour < 19 ? 'golden' : 'night';

  if (!grass) {
    $('grassFallback').hidden = false;
    hint.hidden = true;
  } else {
    select(initial, true);
    modeButtons.forEach((b) => b.addEventListener('click', () => select(b.dataset.mode)));
  }
  changed();
  saveStats(stats);
</script>
